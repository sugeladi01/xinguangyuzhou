# 服务器端口
PORT=3000

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=xinguang

# JWT 密钥（请替换为随机字符串）
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# JWT 过期时间（7天）
JWT_EXPIRES_IN=7d

# Resend API 密钥（用于发送验证码邮件）
# 注册地址: https://resend.com
RESEND_API_KEY=re_xxxxxxxx
